# Google Cloud SQL Configuration
CLOUD_SQL_CONNECTION_NAME=your-project-id:region:instance-name
POSTGRES_DB=course_scheduler
POSTGRES_USER=your-username
POSTGRES_PASSWORD=your-password

# Google Cloud Project (optional, for IAM authentication)
GOOGLE_CLOUD_PROJECT=your-project-id

# Authentication (choose one)
# Option 1: Service Account Key (for local development)
GOOGLE_APPLICATION_CREDENTIALS=/path/to/your/service-account-key.json

# Option 2: Application Default Credentials (preferred)
# Run: gcloud auth application-default login

# Legacy Supabase Configuration (for backward compatibility)
SUPABASE_URL=your-supabase-url
SUPABASE_KEY=your-supabase-key

# Optional: Direct connection fallback (for testing/development)
# POSTGRES_HOST=your-cloud-sql-instance-public-ip
# POSTGRES_PORT=5432